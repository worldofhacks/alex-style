{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"dusk-footer-2","type":"registry:block","title":"Footer 2","description":"Tailark Dusk footer variant 2 block","registryDependencies":["@tailark-oss/dusk-logo","@tailark-oss/dusk-button","@tailark-oss/core-gemini","@tailark-oss/core-claude-ai","@tailark-oss/core-openai"],"meta":{"aspect-ratio":"60/24","width":686,"height":274},"files":[{"path":"dusk/blocks/footer/two.tsx","type":"registry:component","target":"@components/footer-2.tsx","content":"import Link from 'next/link'\nimport { LogoIcon } from '@/components/logo'\nimport { Gemini } from '@/components/ui/svgs/gemini'\nimport { ClaudeAI } from '@/components/ui/svgs/claude-ai'\nimport { Openai } from '@/components/ui/svgs/openai'\nimport { Perplexity } from '@/components/ui/svgs/perplexity'\nimport { Button } from '@/components/ui/button'\n\nconst footerLinks = [\n    {\n        name: 'Product',\n        links: [\n            { href: '#', label: 'Features' },\n            { href: '#', label: 'Solutions' },\n            { href: '#', label: 'Agents' },\n            { href: '#', label: 'Pricing' },\n        ],\n    },\n    {\n        name: 'Company',\n        links: [\n            { href: '#', label: 'About' },\n            { href: '#', label: 'Blog' },\n            { href: '#', label: 'Contact' },\n            { href: '#', label: 'LinkedIn' },\n            { href: '#', label: 'X' },\n        ],\n    },\n    {\n        name: 'Legal',\n        links: [\n            { href: '#', label: 'Licence' },\n            { href: '#', label: 'Privacy Policy' },\n            { href: '#', label: 'Terms of Service' },\n        ],\n    },\n]\n\nexport default function Footer() {\n    return (\n        <footer>\n            <div className=\"mx-auto max-w-7xl space-y-16 px-6 pb-6 pt-32\">\n                <div className=\"grid grid-cols-2 gap-x-3 gap-y-12 sm:grid-cols-4 lg:grid-cols-6\">\n                    <div className=\"col-span-full lg:col-span-3\">\n                        <Link\n                            href=\"/\"\n                            aria-label=\"go home\"\n                        >\n                            <LogoIcon uniColor />\n                        </Link>\n                    </div>\n\n                    {footerLinks.map((linksGroup, index) => (\n                        <div key={index}>\n                            <span className=\"text-foreground text-sm\">{linksGroup.name}</span>\n                            <ul className=\"mt-4 list-inside space-y-4\">\n                                {linksGroup.links.map((link, index) => (\n                                    <li key={index}>\n                                        <Link\n                                            href={link.href}\n                                            className=\"hover:text-primary text-muted-foreground text-sm duration-150\"\n                                        >\n                                            {link.label}\n                                        </Link>\n                                    </li>\n                                ))}\n                            </ul>\n                        </div>\n                    ))}\n                </div>\n                <div className=\"mt-24 grid gap-x-3 gap-y-6 border-t pt-6 sm:grid-cols-2\">\n                    <div>\n                        <p className=\"text-muted-foreground text-sm\">Get an AI summary of this page</p>\n                        <div className=\"-ml-2.5 mt-2 flex items-center\">\n                            <Button\n                                variant=\"ghost\"\n                                size=\"icon\"\n                                asChild\n                            >\n                                <Link\n                                    href=\"#\"\n                                    aria-label=\"Claude AI\"\n                                >\n                                    <ClaudeAI />\n                                </Link>\n                            </Button>\n                            <Button\n                                variant=\"ghost\"\n                                size=\"icon\"\n                                asChild\n                            >\n                                <Link\n                                    href=\"#\"\n                                    aria-label=\"OpenAI\"\n                                >\n                                    <Openai />\n                                </Link>\n                            </Button>\n                            <Button\n                                variant=\"ghost\"\n                                size=\"icon\"\n                                asChild\n                            >\n                                <Link\n                                    href=\"#\"\n                                    aria-label=\"Perplexity\"\n                                >\n                                    <Perplexity className=\"size-5!\" />\n                                </Link>\n                            </Button>\n                            <Button\n                                variant=\"ghost\"\n                                size=\"icon\"\n                                asChild\n                            >\n                                <Link\n                                    href=\"#\"\n                                    aria-label=\"Gemini\"\n                                >\n                                    <Gemini />\n                                </Link>\n                            </Button>\n                        </div>\n                    </div>\n                    <span className=\"text-muted-foreground block text-sm\">&copy; Tailark 2025 - Present</span>\n                </div>\n            </div>\n        </footer>\n    )\n}\n"}]}