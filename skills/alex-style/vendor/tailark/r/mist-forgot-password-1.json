nput\n                                type=\"email\"\n                                required\n                                name=\"email\"\n                                id=\"email\"\n                                placeholder=\"Your email\"\n                                className=\"ring-foreground/15 border-transparent ring-1\"\n                            />\n                        </div>\n\n                        <Button\n                            className=\"w-full\"\n                            size=\"default\"\n                        >\n                            Send Reset Link\n                        </Button>\n                    </div>\n                </div>\n                <div className=\"px-6\">\n                    <p className=\"text-muted-foreground text-sm\">\n                        You remember your password ?\n                        <Button\n                            asChild\n                            variant=\"link\"\n                            className=\"px-2\"\n                        >\n                            <Link href=\"#\">Sign In</Link>\n                        </Button>\n                    </p>\n                </div>\n            </form>\n        </section>\n    )\n}\n"}]}